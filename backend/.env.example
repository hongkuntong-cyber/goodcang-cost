# ============================================================
# 后端环境变量示例 —— 复制为 backend/.env 后填入真实值
# 安全红线：AppToken/AppKey 绝不写入代码，统一走本文件
# ============================================================

# ---- 应用 ----
APP_NAME=GoodCang Cost Intelligence
APP_ENV=dev                # dev / uat / prod
LOG_LEVEL=INFO

# ---- 数据库 ----
# 本地开发
DATABASE_URL=postgresql+psycopg://goodcang:change_me_strong_password@localhost:5432/goodcang_cost
# Docker 编排（db 为容器服务名）
# DATABASE_URL=postgresql+psycopg://goodcang:change_me_strong_password@db:5432/goodcang_cost

# ---- 谷仓 GoodCang Open API ----
# 获取：GWC OMS → 我的 → 开发者信息 → 选择海外仓 → 复制 AppToken/AppKey
GOODCANG_APP_TOKEN=your_app_token_here
GOODCANG_APP_KEY=your_app_key_here

# 接口网关（UAT 联调 / 正式 二选一）
# 2026-09-01 校准：生产环境域名为 oms.goodcang.net（不是 open.goodcang.com）
GOODCANG_BASE_URL=https://oms.goodcang.net
# UAT 测试环境：
# GOODCANG_BASE_URL=https://uat-oms.eminxing.com

# 鉴权方式（2026-09-01 校准自官方文档）：
#   谷仓采用 HTTP Header 鉴权，每次请求注入两个 header：
#     - app-token : AppToken（账号维度）
#     - app-key   : AppKey（账号维度）
#   无需 MD5 签名、无需额外公共参数。请求方法统一 POST + JSON。

# 目标仓：德国海外仓编码（2026-09-01 实调确认德国区代码为 DE）
GOODCANG_WAREHOUSE_CODE=DE

# 请求超时（秒）/ 重试次数
GOODCANG_TIMEOUT=30
GOODCANG_MAX_RETRY=3

# ---- 数据同步调度（cron，可选）----
SYNC_ENABLED=true
SYNC_CRON=0 2 * * *        # 每日 02:00 同步
