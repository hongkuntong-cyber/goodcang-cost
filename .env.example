# ---- PostgreSQL（容器）----
POSTGRES_USER=goodcang
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_DB=goodcang_cost
POSTGRES_PORT=5432

# ---- 后端服务端口 ----
BACKEND_PORT=8000

# ---- 前端服务端口 ----
FRONTEND_PORT=8080
